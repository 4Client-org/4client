generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String    @db.VarChar(200)
  slug                  String    @unique @db.VarChar(50)
  plan                  String    @default("starter") @db.VarChar(20)
  wpp_provider          String    @default("meta_api") @db.VarChar(20)
  wpp_phone             String?   @db.VarChar(20)
  wpp_meta_phone_id     String?   @db.VarChar(100)
  wpp_meta_token        String?
  wpp_meta_app_secret   String?
  welcome_message       String?
  // Org-wide kill switch for form links - "block ALL active links right now"
  // (e.g. the store closes early one day). Same mechanism as Ticket.form_token_min_iat
  // (public.ts's supersede check), just scoped to the whole org instead of one ticket:
  // any token whose `iat` predates this is rejected. A fresh link issued AFTER this
  // moment works normally again - this isn't a permanent shutdown, just "everything
  // outstanding as of right now is dead."
  form_links_blocked_at DateTime? @db.Timestamptz
  active                Boolean   @default(true)
  created_at            DateTime  @default(now()) @db.Timestamptz

  users               User[]
  products            Product[]
  employees           Employee[]
  tickets             Ticket[]
  orders              Order[]
  order_history       OrderHistory[]
  order_observations  OrderObservation[]
  daily_closes        DailyClose[]
  revoked_form_tokens RevokedFormToken[]
  audit_logs          AuditLog[]
  invoice_links       InvoiceLink[]

  @@map("organizations")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        String    @db.Uuid
  email         String    @db.VarChar(200)
  password_hash String    @db.VarChar(100)
  name          String    @db.VarChar(200)
  role          String    @db.VarChar(20)
  active        Boolean   @default(true)
  last_login    DateTime? @db.Timestamptz
  created_at    DateTime  @default(now()) @db.Timestamptz

  org                 Organization       @relation(fields: [org_id], references: [id])
  refresh_tokens      RefreshToken[]
  login_verification_codes LoginVerificationCode[]
  orders_registered   Order[]            @relation("RegisteredBy")
  orders_paid         Order[]            @relation("PaidBy")
  orders_papelera     Order[]            @relation("PapeleraBy")
  history_entries     OrderHistory[]
  order_observations  OrderObservation[]
  sent_messages       TicketMessage[]
  daily_closes        DailyClose[]
  revoked_form_tokens RevokedFormToken[]
  audit_logs          AuditLog[]

  @@unique([org_id, email])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @db.VarChar(100)
  expires_at DateTime @db.Timestamptz
  revoked    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([token_hash])
  @@index([user_id])
  @@map("refresh_tokens")
}

// Second factor at login (currently gated dev-only via config.REQUIRE_2FA) -
// a short-lived one-time code emailed to the user, verified before issuing the
// real accessToken/RefreshToken. Deliberately its own table, not a RefreshToken
// reuse - the semantics differ (one-time + attempt-counted vs long-lived +
// rotation-based).
model LoginVerificationCode {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  code_hash  String   @db.VarChar(100)
  expires_at DateTime @db.Timestamptz
  attempts   Int      @default(0)
  consumed   Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("login_verification_codes")
}

model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id         String   @db.Uuid
  name           String   @db.VarChar(200)
  category       String?  @db.VarChar(100)
  active         Boolean  @default(true)
  sort_order     Int      @default(0)
  price_per_unit Decimal? @db.Decimal(12, 2)
  unit_type      String?  @db.VarChar(20)
  created_at     DateTime @default(now()) @db.Timestamptz

  org Organization @relation(fields: [org_id], references: [id])

  @@index([org_id])
  @@map("products")
}

model Employee {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String   @db.Uuid
  name       String   @db.VarChar(200)
  phone      String?  @db.VarChar(20)
  role       String   @default("domiciliario") @db.VarChar(20)
  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz

  org    Organization @relation(fields: [org_id], references: [id])
  orders Order[]

  @@index([org_id])
  @@map("employees")
}

model Ticket {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id             String    @db.Uuid
  // Not always a real phone number anymore - since Meta's WhatsApp usernames /
  // Business-Scoped User ID (BSUID) rollout (June 2026), a user with a
  // username enabled can arrive with NO phone number at all, only a BSUID
  // instead (format "CC.<up to 128 alphanumeric chars>", e.g.
  // "CO.919210307886008" - widened from 20 to fit). webhook.ts stores
  // whichever identifier Meta actually gave us (msg.from, or msg.from_user_id
  // when that's all there is) - meta-cloud.ts detects the BSUID shape at send
  // time and uses Meta's `recipient` field instead of `to` for it, same
  // message otherwise. Only when BOTH are missing does this fall back to our
  // own unreachable "no-<hex>" placeholder (see no_wpp_number below).
  phone              String    @db.VarChar(150)
  // Set only when Meta's webhook delivered a message with an empty/missing sender
  // phone number (a rare, confirmed-real Meta-side glitch - webhook.ts now
  // persists the raw payload in raw_payload below, since Meta itself gives no
  // way to look up what it sent after the fact, and Railway's own log
  // retention turned out too short to rely on for this). `phone` gets a random
  // unique placeholder ("no-<16 hex>") instead of staying empty, so this
  // ticket doesn't collide with a later, equally-broken message under the same
  // org - there is genuinely no way to reply to this customer, so the UI shows
  // a clear warning instead of a normal (but silently unreachable) chat.
  no_wpp_number      Boolean   @default(false)
  // Secondary identifier - only set when a single webhook contact entry carried
  // BOTH a real wa_id (stored as `phone` above) AND a BSUID user_id. Lets a LATER
  // message from the same person that arrives with ONLY the BSUID (no `from`, just
  // `from_user_id`) still resolve to this same ticket instead of spawning a
  // duplicate - the exact "Vivi"/"dayis" fragmentation bug this org already hit
  // once, being closed off structurally. Never overwrites a value already set.
  bsuid              String?   @unique @db.VarChar(150)
  // The exact webhook POST body that CREATED this ticket (the first message
  // ever received from this phone) - never overwritten on later messages, this
  // is specifically "what did Meta send us that first time", for diagnosing
  // exactly this kind of glitch after the fact. Every individual message's own
  // raw payload lives on TicketMessage.raw_payload below instead - this column
  // is just the founding one, kept here for a quick look without having to
  // find/join the ticket's first message.
  raw_payload        Json?
  customer_name      String?   @db.VarChar(200)
  wpp_thread_id      String?   @db.VarChar(200)
  unread_count       Int       @default(0)
  // Deliberately INBOUND-only (real WhatsApp messages from the customer, never
  // staff replies or automated sends - see inbox.ts/public.ts's own comments)
  // - this is what tickets.ts's board ordering uses, and it must stay that way:
  // "first to arrive stays first" would break if a staff reply bumped it.
  last_message_at    DateTime? @db.Timestamptz
  // Separate from last_message_at above on purpose - the Chats WPP panel
  // (inbox.ts) wants normal WhatsApp-app behavior instead (most recent activity
  // in EITHER direction floats to top, so replying to an old chat brings it back
  // up). Maintained by a DB trigger (see migration
  // 20260802000000_ticket_last_activity), not application code - there are 14+
  // separate TicketMessage.create() call sites across webhook.ts/inbox.ts/
  // public.ts (inbound AND outbound), and a trigger can't be accidentally
  // forgotten at the next one the way a 15th manual bump site could be.
  last_activity_at   DateTime? @db.Timestamptz
  fecha              DateTime  @default(now()) @db.Date
  deferred_to        DateTime? @db.Date
  created_at         DateTime  @default(now()) @db.Timestamptz
  // The CURRENT live form-link token - a short random opaque string (not a JWT),
  // looked up directly by public.ts instead of decoded/verified. Unique so a lookup
  // by an old, already-superseded value simply finds no row (same effect the JWT
  // "superseded" check used to produce, now automatic: overwriting this column IS
  // what kills every earlier link for the ticket, no separate revoke needed). A long
  // self-contained JWT (~280 chars) turned out too fragile for real WhatsApp use -
  // mobile keyboards/clipboards/address bars would silently truncate it, corrupting
  // the signature and showing "link inválido" for a link that was actually fine.
  form_link_token    String?   @unique @db.VarChar(64)
  // Who generated the CURRENT form_link_token (inbox.ts's GET /form-link, or null
  // for the automated send-after-welcome) - replaces the JWT's own sentByUserId
  // claim now that there's no token payload to carry it in. Order attribution
  // (registered_by/history) falls back to the first active admin/encargado when null.
  form_link_sent_by  String?   @db.Uuid
  // Issued-at of the CURRENT form_link_token - null = no link issued yet. Used for
  // both TTL checks (4h-unopened, 24h absolute) and, implicitly, staleness: since
  // there's only ever one live token per ticket, this is simply when THAT token was
  // minted, not a comparison target for a separate incoming value anymore.
  form_token_min_iat DateTime? @db.Timestamptz
  // Set the first time GET /form-info actually succeeds for the CURRENT link (reset
  // to null every time a fresh link is issued, same as form_token_min_iat above). A
  // link nobody opens within 10 minutes of being sent dies on its own (public.ts's
  // assertLinkStillValid) - shrinks how long a link that went to the wrong person
  // (typo'd number, accidental forward) stays usable, without touching the normal
  // end-of-day expiry for a link that WAS opened in time.
  form_link_opened_at DateTime? @db.Timestamptz
  // Wrong-phone-digits guesses against ANY link for this ticket - form link AND
  // every invoice/factura link together (see linkSecurity.ts) - since the last
  // reset. Reset to 0 whenever staff sends a fresh link of EITHER kind (inbox.ts's
  // /form-link route, files.ts's POST /invoice). Once it hits linkSecurity.ts's
  // MAX_ATTEMPTS_SOFT, EVERY outstanding link for this ticket is dead - not just
  // whichever one the wrong guesses happened to land on.
  link_failed_attempts Int       @default(0)
  // Cumulative wrong-digit guesses across EVERY link this ticket has ever issued,
  // since the last time this ticket was hard-blocked. Never reset by a fresh link
  // (unlike link_failed_attempts above) - that's what stops someone from dodging
  // the soft block by just asking staff for a new link every 10 guesses.
  link_failed_total    Int       @default(0)
  // Set once link_failed_total crosses MAX_ATTEMPTS_HARD - blocks every link (form
  // + all invoices) for this ticket until this timestamp, self-expiring with no
  // staff action needed (unlike the manual org-wide "bloquear todos los links").
  link_blocked_until   DateTime? @db.Timestamptz

  org                Organization      @relation(fields: [org_id], references: [id])
  messages           TicketMessage[]
  orders             Order[]
  revoked_form_token RevokedFormToken?
  form_link_session  FormLinkSession?

  // One ticket per customer, forever - not per day. `fecha` still tracks the most
  // recent day this ticket was active (or is queued for, via `deferred_to`) so the
  // day-scoped board/informe queries keep working, but it's no longer part of the
  // ticket's identity: a customer writing again next week continues the same ticket
  // instead of forking a new one that the rest of the app (orders, staff replies)
  // has no way to find.
  @@unique([org_id, phone])
  @@index([org_id, fecha])
  @@index([org_id, deferred_to])
  @@index([org_id, last_message_at])
  @@map("tickets")
}

model TicketMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id      String   @db.Uuid
  direction      String   @db.VarChar(5)
  text           String?
  media_url      String?  @db.VarChar(500)
  media_type     String?  @db.VarChar(50)
  media_caption  String?  @db.VarChar(500)
  sent_by        String?  @db.Uuid
  wpp_message_id String?  @unique @db.VarChar(200)
  // The exact webhook POST body Meta sent for THIS message (inbound only - an
  // outbound row is something WE generated, there's no "raw payload from Meta"
  // to capture for it). Kept forever, not just logged - Railway's own log
  // retention turned out too short to catch a rare glitch (a message arriving
  // with an empty sender phone number) after the fact, and Meta itself keeps
  // no delivery history at all. This is the only durable record of exactly
  // what Meta sent, byte for byte, whenever something needs investigating.
  raw_payload    Json?
  // The message's OWN timestamp - for inbound, Meta's reported client-side send
  // time (webhook.ts's `msg.timestamp`); for outbound, roughly when we sent it.
  // NEVER used for chat ordering (see created_at below) - only for the label
  // shown next to the bubble.
  sent_at        DateTime @default(now()) @db.Timestamptz
  // When THIS ROW was actually inserted (server clock, always monotonic
  // per-ticket in insertion order) - this is what every chat listing orders
  // by, not sent_at. A delayed webhook delivery (Meta retry, network lag) can
  // carry an old `sent_at` for a message that only reaches us much later; if
  // the list sorted by sent_at, that message would insert itself into the
  // MIDDLE of an already-read conversation instead of landing at the bottom
  // where it was actually received - confusing enough on its own, and on a
  // ticket handling more than one order at once it read as if the wrong
  // order/message pairing had happened.
  created_at     DateTime @default(now()) @db.Timestamptz
  // All three driven by Meta's webhook `statuses` array (webhook.ts), matched back
  // to this row by wpp_message_id - previously declared but never actually written,
  // so every outbound message looked permanently "unconfirmed" regardless of what
  // really happened on WhatsApp's side.
  delivered      Boolean  @default(false)
  read_by_client Boolean  @default(false)
  // Set when Meta reports this specific message failed to deliver (invalid number,
  // blocked the business, phone off WhatsApp, etc.) - null means "no failure
  // reported", not "confirmed fine". Distinct from delivered/read_by_client staying
  // false, which just means no status has come back yet (could still be in transit).
  failed_reason  String?  @db.VarChar(255)

  ticket Ticket @relation(fields: [ticket_id], references: [id])
  sender User?  @relation(fields: [sent_by], references: [id])

  @@index([ticket_id, sent_at])
  @@map("ticket_messages")
}

model Order {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id          String    @db.Uuid
  ticket_id       String?   @db.Uuid
  num             String    @db.VarChar(10)
  customer_name   String    @db.VarChar(200)
  // Snapshot of the contact's name (ticket.customer_name, i.e. the WhatsApp
  // profile name) taken ONCE at order creation and never touched by any later
  // update (updateOrderSchema deliberately has no field for it) - unlike
  // `customer_name` above, which staff can freely retype per-order (e.g. to fix a
  // typo, or write a delivery-recipient's name instead of the account holder's).
  // Crédito specifically needs a name that can't drift out from under the debt
  // record no matter what gets edited on the order later - this is that anchor.
  // Null for orders with no ticket (channel 'call') or created before this field
  // existed - callers fall back to `customer_name` in that case.
  client_contact_name String? @db.VarChar(200)
  // Widened to match Ticket.phone - always copied straight from there
  // (orders.ts), so it needs the same room for a BSUID.
  customer_phone  String?   @db.VarChar(150)
  address         String
  channel         String    @default("whatsapp") @db.VarChar(20)
  payment_method  String    @db.VarChar(20)
  status          String    @default("nuevo") @db.VarChar(20)
  employee_id     String?   @db.Uuid
  registered_by   String    @db.Uuid
  fecha           DateTime  @default(now()) @db.Date
  order_hour      DateTime  @default(now()) @db.Time
  paid            Boolean   @default(false)
  paid_at         DateTime? @db.Timestamptz
  paid_by         String?   @db.Uuid
  amount_received Decimal?  @db.Decimal(12, 2)
  change_amount   Decimal?  @db.Decimal(12, 2)
  // Which of the two cobro-en-casa choices staff actually picked ('completo' |
  // 'vuelta'), stored explicitly rather than inferred by comparing amount_received
  // to the total - inferring broke the one time "vuelta" happens to be typed as
  // exactly the total (zero change owed): that's indistinguishable from "completo"
  // by value alone, so reopening the order silently flipped the shown choice.
  cod_choice      String?   @db.VarChar(10)
  // Set together, only when staff splits a single cobro across efectivo AND
  // transferencia (e.g. client pays part cash, part transfer) - both null on
  // every normal, single-method order. `payment_method` itself is untouched by
  // this (stays whatever it already was) - this is purely a breakdown of how
  // the money that closed the order was actually split, used by cierre.ts/
  // dashboard.ts to route each piece into the right efectivo/transferencia
  // bucket instead of dumping the whole total into just one.
  split_cash      Decimal?  @db.Decimal(12, 2)
  split_transfer  Decimal?  @db.Decimal(12, 2)
  locked          Boolean   @default(false)
  caja_cerrada    Boolean   @default(false)
  source          String    @default("encargado") @db.VarChar(20)
  notes           String?
  // Set whenever the CLIENT (not staff) adds/edits/removes items on this order via
  // the public form's merge flow - cleared when staff saves the order (routes/orders.ts
  // PATCH /:id), which is treated as "staff reviewed the change". Independent of any
  // individual item's own `added_by_client` flag below, which never clears - this is
  // a transient "needs attention" signal, that's permanent provenance.
  client_modified Boolean   @default(false)
  // The client deleted this order themselves via their form link (public.ts's
  // POST /order/:orderId/delete) - deliberately NOT the same as status:'papelera'
  // (that's still staff's own separate trash action, untouched by this): `status`
  // is left exactly as it was, so the order keeps rendering in its normal board
  // column, just tinted red with a warning - staff decides Restaurar (clears this
  // flag) or "Mantener eliminado" (leaves it flagged, order stays frozen).
  // Excluded from cierre/dashboard totals wherever it matters (treated as if it
  // doesn't exist for accounting purposes) but still visible on the live board.
  client_deleted  Boolean   @default(false)
  // Staff-initiated trash (PATCH /:id/status status:'papelera') - unlike
  // client_deleted above, this ALSO changes `status`, so these three fields record
  // what to restore back to. All three are cleared together on restore; a
  // subsequent re-send to papelera repopulates them and requires a fresh reason
  // (never carried over from a prior trip to papelera).
  papelera_reason        String?  @db.VarChar(500)
  papelera_by            String?  @db.Uuid
  status_before_papelera String?  @db.VarChar(20)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  org          Organization   @relation(fields: [org_id], references: [id])
  ticket       Ticket?        @relation(fields: [ticket_id], references: [id])
  employee     Employee?      @relation(fields: [employee_id], references: [id])
  registeredBy User           @relation("RegisteredBy", fields: [registered_by], references: [id])
  paidBy       User?          @relation("PaidBy", fields: [paid_by], references: [id])
  papeleraBy   User?          @relation("PapeleraBy", fields: [papelera_by], references: [id])
  items        OrderItem[]
  history      OrderHistory[]
  observations OrderObservation[]

  @@unique([org_id, num, fecha])
  @@index([org_id, fecha])
  @@index([ticket_id])
  @@index([org_id, status])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id        String   @db.Uuid
  product_name    String   @db.VarChar(200)
  quantity_label  String?  @db.VarChar(100)
  price           Decimal  @default(0) @db.Decimal(12, 2)
  sort_order      Int      @default(0)
  quantity_value  Decimal? @db.Decimal(10, 3)
  quantity_unit   String?  @db.VarChar(20)
  // True if a client (via the public form's merge flow) added this line or changed
  // its quantity - never reset back to false afterward, even once staff has dealt
  // with it, so the item's origin stays visible in the UI (rendered in red) for as
  // long as the order exists. Items from the original submission or staff's own
  // entry stay false forever.
  added_by_client Boolean  @default(false)

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_items")
}

model OrderHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id       String   @db.Uuid
  order_id     String   @db.Uuid
  actor_id     String   @db.Uuid
  action_type  String   @db.VarChar(20)
  field        String?  @db.VarChar(100)
  value_before String?
  value_after  String?
  notes        String?
  created_at   DateTime @default(now()) @db.Timestamptz

  org   Organization @relation(fields: [org_id], references: [id])
  order Order        @relation(fields: [order_id], references: [id])
  actor User         @relation(fields: [actor_id], references: [id])

  @@index([order_id])
  @@index([org_id, created_at])
  @@map("order_history")
}

// A note pinned to an order, always addable/editable even on a locked/closed
// order or a day already cerrado (orders.ts's observation routes carve out the
// same exception the old single `observacion` column used to have on PATCH /:id).
// Multiple entries per order now (append, don't overwrite) - each one can only be
// edited by the staff member who wrote it (author_id checked against the acting
// user), everyone else sees it read-only. Every create/edit also writes an
// OrderHistory row so it shows up in the order's audit trail like any other change.
model OrderObservation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String   @db.Uuid
  order_id   String   @db.Uuid
  author_id  String   @db.Uuid
  text       String   @db.VarChar(1000)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  org    Organization @relation(fields: [org_id], references: [id])
  order  Order        @relation(fields: [order_id], references: [id])
  author User         @relation(fields: [author_id], references: [id])

  @@index([order_id])
  @@map("order_observations")
}

model DailyClose {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id         String   @db.Uuid
  fecha          DateTime @db.Date
  total_cash     Decimal  @default(0) @db.Decimal(12, 2)
  total_transfer Decimal  @default(0) @db.Decimal(12, 2)
  total_grand    Decimal  @default(0) @db.Decimal(12, 2)
  total_orders   Int      @default(0)
  closed_orders  Int      @default(0)
  decisions      Json?
  report_url     String?  @db.VarChar(500)
  closed_by      String   @db.Uuid
  closed_at      DateTime @default(now()) @db.Timestamptz

  org      Organization @relation(fields: [org_id], references: [id])
  closedBy User         @relation(fields: [closed_by], references: [id])

  @@unique([org_id, fecha])
  @@map("daily_closes")
}

// One row per ticket at most - revoking early-invalidates that ticket's currently
// outstanding form-link token (public.ts checks this before form-info/products/submit).
// Generating a fresh link afterwards works normally: it's a new JWT, this row just
// blocks whichever token was already issued when revoke was clicked.
model RevokedFormToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String   @db.Uuid
  ticket_id  String   @unique @db.Uuid
  reason     String?  @db.VarChar(255)
  revoked_at DateTime @default(now()) @db.Timestamptz
  revoked_by String   @db.Uuid

  org       Organization @relation(fields: [org_id], references: [id])
  ticket    Ticket       @relation(fields: [ticket_id], references: [id])
  revokedBy User         @relation(fields: [revoked_by], references: [id])

  @@index([org_id])
  @@map("revoked_form_tokens")
}

// Claims a ticket's form-link for whichever browser/device opens it FIRST - there's
// no real "device identity" reachable from a web page, so `device_token` is just a
// random value the client generates once and persists in its own localStorage
// (public.ts's routes below). First request for a ticket with no row yet claims it;
// any later request presenting a DIFFERENT device_token is rejected as if the link
// were invalid, same as an expired/revoked one (never reveals *why* it failed).
// Cleared whenever staff issues a fresh link for this ticket (inbox.ts) - that's a
// deliberate "start over" action, e.g. after a false-positive lockout.
model FormLinkSession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id    String   @unique @db.Uuid
  device_token String   @db.VarChar(100)
  claimed_at   DateTime @default(now()) @db.Timestamptz

  ticket Ticket @relation(fields: [ticket_id], references: [id])

  @@map("form_link_sessions")
}

// A factura PDF is shared with the client the exact same way a form link is - a
// bare URL sent over WhatsApp, so it gets the same protections (routes/files.ts):
// a phone_last4 check (proves whoever opens it knows the customer's number), a
// 10-minute-unopened-dies window, and now the same "Bloquear link"/"Bloquear todos
// los links" kill switches a form link already had - staff blocking a ticket's link
// (e.g. sent to the wrong number) must kill any factura sent to that same
// conversation too, not just the form link. Unlike a form link there's no Ticket/
// Order row this naturally lives on (the file itself is just a blob in R2/local disk
// with no DB identity), so this is its own small table instead.
model InvoiceLink {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id      String    @db.Uuid
  // Nullable - an invoice for an order with no linked ticket (e.g. a phone-channel
  // order with no WhatsApp thread) has nothing to scope a per-ticket revoke to;
  // it still gets the org-wide block-all and its own phone_last4/TTL protections.
  ticket_id   String?   @db.Uuid
  // Nullable only for rows created before this column existed (old test data) -
  // POST /invoice always sets it going forward. The factura PDF is a static
  // snapshot generated once, not re-rendered live, so if staff edits the order
  // afterward (items, address, payment method...) an already-sent factura silently
  // goes stale with no way to tell the client "there's a newer one." Scoped to the
  // ORDER specifically, not the whole ticket - editing order A must not kill order
  // B's still-accurate factura just because they're in the same conversation
  // (unlike ticket_id above, which IS meant to cascade for the manual block button).
  order_id    String?   @db.Uuid
  filename    String    @unique @db.VarChar(300)
  phone_last4 String    @db.VarChar(4)
  opened_at   DateTime? @db.Timestamptz
  revoked_at  DateTime? @db.Timestamptz
  created_at  DateTime  @default(now()) @db.Timestamptz

  org Organization @relation(fields: [org_id], references: [id])

  @@index([ticket_id])
  @@index([order_id])
  @@map("invoice_links")
}

// Trail for security-sensitive account/config actions (user create, password reset,
// role/active change, WPP credential update) - none of these were logged anywhere
// before, unlike Order which already has OrderHistory. Write-only from the app's
// perspective; read via the /dev DB viewer (dev role only).
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String   @db.Uuid
  actor_id   String   @db.Uuid
  action     String   @db.VarChar(50)
  target_id  String?  @db.Uuid
  metadata   Json?
  created_at DateTime @default(now()) @db.Timestamptz

  org   Organization @relation(fields: [org_id], references: [id])
  actor User         @relation(fields: [actor_id], references: [id])

  @@index([org_id, created_at])
  @@map("audit_logs")
}
